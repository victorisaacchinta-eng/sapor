# Qloo hackathon credential. Server only. Never commit a real value.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Food photos (optional). Unsplash is used first; Pexels if only its key is set.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Optional language layer. Any one is enough; Sapor tries them in this order
# and falls back to templates if none are set or all are rate limited.
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# CEREBRAS_MODEL=gpt-oss-120b
# GEMINI_MODEL=gemini-flash-lite-latest
